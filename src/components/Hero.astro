---
import CarteCompteur from "./CarteCompteur.astro";
import chiffres from "../data/chiffres.json";

const grand = chiffres.categorie_principale.parTaille.find((d) => d.taille === "grand")!;
---

<section
  id="hero"
  data-jeton="0-29"
  data-jeton-boucle
  class="relative h-screen min-h-[780px] overflow-hidden pt-20"
  aria-labelledby="titre-hero"
>
  <p class="mot-geant absolute left-1/2 top-[12%] -translate-x-1/2" aria-hidden="true">TOKEN</p>

  <div class="conteneur relative h-full">
    <div
      class="pointer-events-none absolute left-1/2 top-[40%] aspect-square w-[min(58vh,580px)] -translate-x-1/2 -translate-y-1/2"
      data-jeton-cible
      aria-hidden="true"
    >
      <img id="jeton-fixe" src="/3d/jeton-fixe.webp" alt="" width="1600" height="1600" fetchpriority="high" decoding="async" class="h-full w-full" />
    </div>

    <CarteCompteur
      class="absolute right-12 top-[24%] w-[330px]"
      etiquette="Grand modèle"
      valeur={grand.wh_1000_tokens_median}
      legende={`pour 1 000 tokens · ${chiffres.categorie_principale.nom.toLowerCase()}`}
      repere
    />

    <div class="absolute inset-x-0 bottom-[7%] text-center">
      <h1 id="titre-hero" class="mx-auto max-w-[1100px] text-[clamp(44px,4vw,60px)]">Ce que coûte vraiment une réponse d'IA</h1>
      <div class="mt-8 flex justify-center gap-4">
        <a href="/demandes" class="btn btn-primary btn-lg rounded-full px-8">Compare ta demande</a>
        <a href="#contexte" class="btn btn-outline btn-lg rounded-full border-2 border-navy px-8 text-navy hover:bg-navy hover:text-white">Comprendre</a>
      </div>
    </div>
  </div>
</section>
