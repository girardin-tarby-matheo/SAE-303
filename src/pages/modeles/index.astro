---
import Base from "../../layouts/Base.astro";
import Figure from "../../components/Figure.astro";
import EtiquetteTaille from "../../components/EtiquetteTaille.astro";
import { barresModeles } from "../../lib/graphiques";
import { documentBuild } from "../../lib/dom";
import { nombre, wh, tokens } from "../../lib/format";
import type { Modele } from "../../lib/types";
import modelesJson from "../../data/modeles.json";
import chiffres from "../../data/chiffres.json";

const modeles = modelesJson as Modele[];
// gRelatif du notebook : les 15 modèles les plus utilisés, comparés par conversation (jamais par total)
const plusUtilises = modeles.toSorted((a, b) => b.n_conv - a.n_conv).slice(0, 15);
const parConv = plusUtilises.toSorted((a, b) => (b.wh_median_conv ?? 0) - (a.wh_median_conv ?? 0));
const facteur = Math.round(parConv[0].wh_median_conv! / parConv.at(-1)!.wh_median_conv!);
const svgRelatif = barresModeles(plusUtilises, {
    label: "Wh par conversation (médiane) des 15 modèles les plus utilisés",
    document: documentBuild(),
}).outerHTML;
const TAILLES = ["tous", "petit", "moyen", "grand", "inconnue"] as const;
const parTaille = (t: string) =>
    modeles.filter((m) => t === "tous" || m.taille === t).length;
---

<Base
    titre="Classement des modèles"
    description="Les modèles d'IA classés du plus sobre au plus gourmand : électricité d'une conversation typique, données Compar:IA."
>
    <section class="relative overflow-hidden pb-14 pt-40">
        <p class="mot-geant absolute -right-16 top-24" aria-hidden="true">
            MODÈLES
        </p>
        <div class="conteneur relative">
            <span class="kicker"
                >Classement · {modeles.length} modèles retenus</span
            >
            <h1 class="titre-1 mt-6 max-w-5xl">
                Les modèles, du plus sobre au plus gourmand
            </h1>
            <p class="mt-6 max-w-2xl text-[19px] text-doux">
                Électricité d'une conversation typique (médiane des Wh par
                conversation), pour chaque modèle ayant au moins {
                    chiffres.modeles.seuil_conversations
                } conversations en français.
            </p>
        </div>
    </section>

    <section class="pb-12" aria-label="Classement">
        <div class="conteneur">
            <Figure
                titre="Électricité d'une conversation typique, 15 modèles les plus utilisés"
                sousTitre={`Par conversation, l'électricité varie d'un facteur ${facteur} d'un modèle à l'autre`}
                svg={svgRelatif}
                alt={`Diagramme en barres horizontales. Il compare l'électricité d'une conversation typique (médiane des Wh par conversation) des 15 modèles les plus utilisés sur Compar:IA en français. Du plus gourmand au plus sobre : ${parConv.map((m) => `${m.modele} ${wh(m.wh_median_conv)}`).join(" ; ")}.`}
                source={`Source : Compar:IA (données au ${chiffres.source.date}), estimation EcoLogits · médiane des Wh par conversation · conversations en français · les ${modeles.length} modèles sont dans le tableau`}
            />
        </div>
    </section>

    <section class="pb-32" aria-labelledby="titre-tableau">
        <div class="conteneur">
            <div class="carte p-10">
                <h2 id="titre-tableau" class="text-[22px]">Tableau complet</h2>
                <p class="mt-2 text-doux">
                    Les {modeles.length} modèles retenus, du plus sobre au plus
                    gourmand, avec le nombre de conversations (le dénominateur,
                    pour vérifier).
                </p>
            <div
                data-filtre-zone
                hidden
                class="mt-6 flex items-center justify-between"
            >
                <div
                    class="join"
                    role="group"
                    aria-label="Filtrer par taille de modèle"
                >
                    {
                        TAILLES.map((t) => (
                            <button
                                type="button"
                                data-filtre={t}
                                aria-pressed={t === "tous" ? "true" : "false"}
                                class="btn join-item border-trait bg-white px-6 text-navy aria-pressed:border-navy aria-pressed:bg-navy aria-pressed:text-white"
                            >
                                {t}{" "}
                                <span class="chiffre text-[12px] opacity-70">
                                    {parTaille(t)}
                                </span>
                            </button>
                        ))
                    }
                </div>
                <p
                    class="font-mono text-[13px] text-doux"
                    data-filtre-compte
                    aria-live="polite"
                >
                    {modeles.length} modèles affichés
                </p>
            </div>


                <div
                    class="mt-6 max-h-[720px] overflow-auto rounded-[12px] border border-trait"
                >
                    <table class="table table-pin-rows text-[14px]">
                        <caption class="sr-only"
                            >Modèles retenus, du plus sobre au plus gourmand</caption
                        >
                        <thead>
                            <tr
                                class="bg-glace font-mono text-[12px] uppercase text-navy"
                            >
                                <th scope="col">N°</th>
                                <th scope="col">Modèle</th>
                                <th scope="col">Taille</th>
                                <th scope="col" class="text-right"
                                    >Paramètres actifs</th
                                >
                                <th scope="col" class="text-right"
                                    >Conversations</th
                                >
                                <th scope="col" class="text-right"
                                    >Tokens / réponse</th
                                >
                                <th scope="col" class="text-right"
                                    >Wh / 1 000 tokens</th
                                >
                                <th scope="col" class="text-right"
                                    >Wh / conversation</th
                                >
                            </tr>
                        </thead>
                        <tbody class="chiffre">
                            {
                                modeles.map((m) => (
                                    <tr
                                        data-taille={m.taille}
                                        data-compte
                                        class="hover:bg-glace"
                                    >
                                        <td class="text-doux">
                                            {String(m.rang).padStart(3, "0")}
                                        </td>
                                        <th
                                            scope="row"
                                            class="whitespace-nowrap font-sans font-semibold"
                                        >
                                            <a
                                                class="underline-offset-4 hover:underline"
                                                href={`/modeles/${m.slug}`}
                                            >
                                                {m.modele}
                                            </a>
                                        </th>
                                        <td>
                                            <EtiquetteTaille
                                                taille={m.taille}
                                            />
                                        </td>
                                        <td class="text-right">
                                            {m.params_actifs != null
                                                ? `${nombre(m.params_actifs)} Md`
                                                : "non publiés"}
                                        </td>
                                        <td class="text-right">
                                            {nombre(m.n_conv)}
                                        </td>
                                        <td class="text-right">
                                            {tokens(m.tokens_median)}
                                        </td>
                                        <td class="text-right">
                                            {wh(m.wh_1000_tokens, false)}
                                        </td>
                                        <td class="text-right font-semibold">
                                            {wh(m.wh_median_conv, false)}
                                        </td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</Base>

<script>
    import "../../scripts/filtre-taille";
</script>
